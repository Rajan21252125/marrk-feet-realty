{
    "extends": [
        "stylelint-config-standard",
        "stylelint-config-tailwindcss",
        "stylelint-config-standard-scss"
    ],
    "rules": {
        "at-rule-no-unknown": [
            true,
            {
                "ignoreAtRules": [
                    "tailwind",
                    "theme",
                    "apply",
                    "variants",
                    "responsive",
                    "screen"
                ]
            }
        ],
        "scss/at-rule-no-unknown": [
            true,
            {
                "ignoreAtRules": [
                    "theme"
                ]
            }
        ]
    }
}